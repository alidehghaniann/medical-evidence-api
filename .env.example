PERPLEXITY_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
APP_ENV=development
# Development defaults to local query understanding. Set OLLAMA_MODEL to a model installed in Ollama.
QUERY_UNDERSTANDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# DEVELOPMENT/TEST ONLY: exact evidence excerpts; use perplexity for real synthesis.
ANSWER_PROVIDER=dev
